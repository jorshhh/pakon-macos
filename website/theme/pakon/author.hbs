{{!< default}}

<section class="section">
    <div class="wrap">
        {{#author}}
        <header class="page-head">
            <p class="tag-pill">Author</p>
            <h1 class="section__title">{{name}}</h1>
            {{#if bio}}<p class="section__lede">{{bio}}</p>{{/if}}
        </header>
        {{/author}}

        <div class="post-feed">
            {{#foreach posts}}
                {{> "post-card"}}
            {{/foreach}}
        </div>
        {{pagination}}
    </div>
</section>
