{{!< default}}

{{#post}}
<article class="article {{post_class}}">
    {{#if @page.show_title_and_feature_image}}
        <header class="article__head wrap wrap--text">
            <h1 class="article__title">{{title}}</h1>
        </header>
        {{#if feature_image}}
            <figure class="article__image wrap">
                <img src="{{img_url feature_image size="l"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
            </figure>
        {{/if}}
    {{/if}}

    <div class="gh-content wrap wrap--text">
        {{content}}
    </div>
</article>
{{/post}}
