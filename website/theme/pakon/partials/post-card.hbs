<article class="post-card {{post_class}}">
    <a class="post-card__link" href="{{url}}">
        {{#if feature_image}}
            <img class="post-card__image"
                srcset="{{img_url feature_image size="s"}} 400w, {{img_url feature_image size="m"}} 800w"
                sizes="(max-width: 700px) 100vw, 400px"
                src="{{img_url feature_image size="m"}}"
                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                loading="lazy">
        {{/if}}
        <div class="post-card__body">
            {{#primary_tag}}<span class="post-card__tag">{{name}}</span>{{/primary_tag}}
            <h3 class="post-card__title">{{title}}</h3>
            {{#if excerpt}}<p class="post-card__excerpt">{{excerpt words="28"}}</p>{{/if}}
            <p class="post-card__meta"><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM YYYY"}}</time> · {{reading_time}}</p>
        </div>
    </a>
</article>
