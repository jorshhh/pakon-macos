# build output
/build/
*.o
*.a

# cmake in-source artifacts (prefer cmake -S . -B build)
CMakeCache.txt
CMakeFiles/
CTestTestfile.cmake
cmake_install.cmake
Makefile

# editor / OS cruft
.DS_Store
*.swp

# local Claude Code state, but track shared project skills
.claude/*
!.claude/skills/

# decoded scan output (large; regenerate with pakon_image.py)
frame_*.tif
frame_*.png
*.raw

# python cruft
__pycache__/
*.pyc

# full OEM install + reverse-engineering workspace (the files the pipeline needs
# are committed under oem/)
/pakon-scanning-software/
/re/

# local python venv for the image tools
/.venv/
scratch/

# personal EEPROM archives (test fixtures remain tracked)
/backups/
.venv/

# OEM firmware, user-supplied (see firmware/README.md)
/firmware/*.hex
/firmware/*.sys
