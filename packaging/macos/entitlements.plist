<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Pakon.app runs Python in its own process under the hardened runtime:
         ctypes (PyUSB, pyobjc) needs writable+executable memory, unicorn (the
         OEM scene balance emulator, tools/oem_sba.py) JIT-compiles x86 code,
         and the frozen Python loads the bundle's own libraries, which ad hoc
         signing gives no team ID. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
